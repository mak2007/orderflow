{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/auth/login", "destination": "/api/auth.js" },
    { "source": "/api/auth/status", "destination": "/api/auth.js" },
    { "source": "/api/state", "destination": "/api/state.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
